# Copy to .env and adjust. These are LOCAL DEV defaults — never put production
# secrets in this file (it is committed). Every variable here is validated on
# boot (src/env.ts); the app refuses to start if any is missing or malformed.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=devpass
DB_NAME=mission_demo
PORT=3000

# Authentication mode (Item 1).
#   dev  — identity from an X-User-Id header the client sets. INSECURE; local /
#          test use only. The server logs a loud warning at boot in this mode.
#   lti  — identity from the LTI 1.3 launch token (provider is a stub for now).
# Unset means dev OUTSIDE production. With NODE_ENV=production the server
# REFUSES TO BOOT unless AUTH_MODE is set explicitly, and refuses AUTH_MODE=dev:
# there is no production configuration that reaches dev auth.
AUTH_MODE=dev

# Deployment environment: development (default) | test | production.
# Production fails closed. With NODE_ENV=production the server refuses to boot if
# SESSION_SECRET is missing or short, AUTH_MODE is unset or dev, or
# ENABLE_TEST_HOOKS is set; the session cookie is Secure (HTTPS only).
# Destructive commands (npm run db:seed, migrate down / down:all,
# scripts/restore.sh, demo-reset.sh) refuse to run under production unless given
#   --i-understand-this-destroys-production-data
NODE_ENV=development

# Signs the staff session cookie (username/password login). Leave blank locally
# to use a known dev key (the server warns). MUST be a random 32+ char string in
# production. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Absolute session lifetime in SECONDS (default 43200 = 12h), enforced by the
# server from the issue time stored inside the signed session. A cookie older
# than this is refused however long the browser was told to keep it.
SESSION_MAX_AGE=43200

# SameSite policy for the session cookie: lax (default) | strict | none.
# Keep 'lax' while only staff log in. Set 'none' (which forces Secure/HTTPS) when
# the Moodle LTI launch is wired up — the launch is a cross-site POST, usually in
# an iframe, and needs SameSite=None. See the README "Session cookie" section.
SESSION_SAMESITE=lax

# Double-submit CSRF enforcement: false (default) | true. While the session
# cookie is SameSite=Lax the browser already blocks cross-site POSTs, so
# enforcement is off. Flip to 'true' in the SAME change that sets
# SESSION_SAMESITE=none for the LTI launch. The client always sends the
# X-CSRF-Token header, so flipping this needs no call-site changes.
CSRF_ENFORCED=false

# Password given to the seeded staff accounts (sme/qc/instructor/admin) by
# `npm run db:seed`. Local default is "changeme" when unset; the seed warns.
# Change per-account with:  npm run set-password -- <username> <newpassword>
STAFF_DEFAULT_PASSWORD=

# Logging (Item 2). LOG_LEVEL: trace|debug|info|warn|error|fatal (default info).
LOG_LEVEL=info
# Optional Sentry error tracking. If unset, Sentry is a no-op and the app runs
# unchanged (the package is only loaded when a DSN is present).
SENTRY_DSN=

# Stage 3 cold-start strategy for brand-new students with no history.
#   SEGMENT_START (default) — level := segment.start_level, placement complete.
#   PLACEMENT               — a fast 5-mission placement ladder (implemented but
#                             not the default). See src/coldstart.ts.
COLD_START_STRATEGY=SEGMENT_START

# Stage 5 — does feedback gate the next slot's unlock?
#   TRUE (default) — the next slot stays locked after grading until the student
#                    submits feedback for the graded mission. Keeps feedback
#                    completion high, which the mission-quality report depends on.
#   FALSE          — the next slot unlocks immediately (Stage 3 behaviour) and
#                    feedback is optional. The weekly slot is never gated either way.
FEEDBACK_GATES_UNLOCK=TRUE

# Mission selection mode.
#   legacy (default) — the pre-curriculum difficulty + interest selection.
#   curriculum       — missions are scoped to the student's curriculum position:
#                      only sessions at or before it, never a later credit. A
#                      student with no position is served nothing and an alert is
#                      logged (alert=missing_curriculum_position); there is no
#                      silent fallback to legacy.
# Flip the default to curriculum once every live student has a backfilled
# position — until then legacy keeps existing subjects working unchanged.
SELECTION_MODE=legacy

# How many sessions before the current one are in a student's base pool.
# 0 = every earlier session in the current credit. 3 = the current plus 3 before.
POOL_LOOKBACK_SESSIONS=0

# What an LMS completion percentage is a percentage OF, when a position has to be
# derived from it: credit | project | track. Unconfirmed with the LMS; every
# derivation is logged with the scope used.
PERCENT_SCOPE=credit

# How often curriculum selection deliberately revises: the percentage of
# selections drawn from an earlier session even when the current session still
# has unseen missions. 20 = roughly one pick in five. 0 disables revision mixing.
# When no earlier session qualifies the roll simply falls through to the current
# session, so this never produces an empty slot.
REVISION_MIX_PERCENT=20

# ---------------------------------------------------------------------------
# The weekly pilot report (/staff/pilot-report, /api/pilot-report)
# ---------------------------------------------------------------------------
# How many weeks back the report looks. Coverage ignores it — the curriculum has
# no window.
REPORT_WEEKS=8
# The ONE timezone the report cuts its weeks in, so a "week beginning" means the
# same thing in every row. The named zone must be loaded in MySQL
# (`npm run db:timezones`), or CONVERT_TZ returns NULL and the report refuses to
# build rather than reporting an empty window.
REPORT_TIMEZONE=Asia/Kolkata
# Upper bound in MINUTES of each mission time band; a band's lower bound is the
# previous band's upper bound, so these must increase. The report compares real
# submit times against these to say which bands are wrong — they are an
# ASSUMPTION nobody has confirmed yet, which is why they are configuration.
# TIME_BAND_MINUTES=short=10,medium=25,long=45,heavy=90

# Path to mysqldump, for a local (non-Docker) MySQL install. verify:migrations
# uses it to diff a fresh scratch DB against the current one; left unset it
# falls back to `docker exec` against the mission-mysql container.
# MYSQLDUMP=C:/path/to/mysql/bin/mysqldump.exe

# NOTE: ENABLE_TEST_HOOKS is intentionally NOT listed here. It exposes test-only
# routes (/api/test/*) and makes feedback gating runtime-injectable; it is for
# the local test harnesses only. The server logs a loud warning if it is set,
# and REFUSES TO BOOT if it is set with NODE_ENV=production. In production the
# /api/test/* routes are not registered at all.
