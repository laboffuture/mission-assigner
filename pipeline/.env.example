# -----------------------------------------------------------------------------
# Stage 2 pipeline configuration. Copy to `.env` and fill in.
# The .env file is gitignored — never commit real keys.
# -----------------------------------------------------------------------------

# --- Database (the SAME MySQL 8 instance the Node app uses) -------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=devpass
DB_NAME=mission_demo

# --- LLM provider ------------------------------------------------------------
# One of: anthropic | openai | mock
#   anthropic / openai -> real API calls, require the matching key below.
#   mock               -> offline, deterministic, no key needed. TEST USE ONLY.
LLM_PROVIDER=mock

# Model id for the chosen provider (ignored by mock).
#   anthropic example: claude-opus-4-8   (or a cheaper claude-haiku-* for drafting)
#   openai example:    gpt-4o
LLM_MODEL=claude-opus-4-8

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
