{
  "name": "mission-hub-web",
  "version": "1.0.0",
  "private": true,
  "description": "Mission Hub \u2014 student web UI (Next.js App Router, same-origin with the Express API)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0",
    "check:tokens": "node scripts/generate-lms-tokens.mjs --check && node scripts/check-no-raw-values.mjs",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:tokens": "node scripts/generate-lms-tokens.mjs",
    "predev": "npm run gen:tokens",
    "prebuild": "npm run gen:tokens",
    "report:contrast": "node scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "20.14.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.13",
    "typescript": "5.5.4"
  }
}
