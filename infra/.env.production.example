# Mission Hub — production configuration TEMPLATE.
#
# Copy to .env.production ON THE SERVER and fill in. Never commit the filled
# copy, never paste a secret into chat, a ticket or a terminal that is being
# recorded. Every value marked <set-on-host> is a secret: set it with the host's
# own mechanism (see infra/README.md, "Secrets").
#
# The app REFUSES TO BOOT under NODE_ENV=production if a secret still holds an
# example value from this file — so a half-filled copy fails immediately and
# loudly, not quietly at 2am. (src/env.ts, verify:ops case [4].)

# --------------------------------------------------------------- identity ---
# The public hostname Caddy serves and obtains a certificate for. LTI requires
# HTTPS, so this must be a real name that resolves to this server.
SITE_ADDRESS=missions.example.org

# Where Let's Encrypt sends expiry warnings. A team address, not a person.
ACME_EMAIL=ops@example.org

# The LMS origin allowed to embed us in an iframe. Becomes the
# frame-ancestors policy: anything else cannot frame the tool.
LMS_ORIGIN=https://lms.example.org

# ------------------------------------------------------------------- data ---
# MySQL runs in the compose network; only these services reach it.
DB_NAME=mission_demo
DB_PASS=<set-on-host>

# --------------------------------------------------------------- sessions ---
# Signs the session cookie. Anyone holding it can forge any student's session.
#   openssl rand -hex 32
SESSION_SECRET=<set-on-host>

# Session lifetime in seconds (12 hours). The server enforces it; a cookie
# older than this is refused even if the signature is valid.
SESSION_MAX_AGE=43200

# We run inside the LMS's iframe, which is cross-site: the cookie needs
# SameSite=None, and therefore Secure, which is why HTTPS is not optional.
SESSION_SAMESITE=none

# Proxy hops in front of the api (Caddy = 1). TLS ends at Caddy, so without
# this the app sees plain HTTP, considers the connection insecure and never
# sets the Secure session cookie — nobody can sign in. Leave it at 1.
TRUST_PROXY=1

# ---------------------------------------------------------------- safety ---
# Identity comes from the LTI launch. Never 'dev' here: dev auth trusts a
# client-supplied header, so anyone could act as anyone. The app refuses to
# boot with AUTH_MODE=dev (or unset) when NODE_ENV=production.
AUTH_MODE=lti

# Double-submit CSRF enforcement. On in production.
CSRF_ENFORCED=true

# Mission selection. Leave as 'legacy' for the pilot: curriculum mode is built
# and tested but waits on two inputs from the LMS team.
SELECTION_MODE=legacy

# One instance for the pilot. The rate limiter and the question cache live in
# this process, so a second instance would silently disagree with the first:
# the app refuses to boot if this is greater than 1 (see infra/README.md).
INSTANCE_COUNT=1

# --------------------------------------------------------------- backups ---
# S3-compatible object storage. A backup that never leaves the machine does not
# survive the failure it exists for.
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.example.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=mission-hub-backups
BACKUP_S3_ACCESS_KEY=<set-on-host>
BACKUP_S3_SECRET_KEY=<set-on-host>

# Retention, applied locally AND remotely.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# ------------------------------------------------------- observability ----
# Error reporting. Leave empty to disable; set to the project DSN to enable.
SENTRY_DSN=
LOG_LEVEL=info

# ------------------------------------------------------------------ notes ---
# ENABLE_TEST_HOOKS is deliberately ABSENT. It exposes /api/test/* (runtime
# reconfiguration, log access) and the app refuses to boot with it set under
# NODE_ENV=production. Do not add it here, not even commented out with a value.
