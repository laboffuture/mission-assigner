{
  "name": "mission-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Student mission automation demo — adaptive difficulty ladder",
  "scripts": {
    "db:migrate": "tsx src/migrator.ts up",
    "db:migrate:down": "tsx src/migrator.ts down",
    "db:migrate:status": "tsx src/migrator.ts status",
    "db:seed": "tsx src/seed.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "backup:verify": "bash scripts/backup-verify.sh",
    "publish": "tsx src/publish.ts",
    "dev": "tsx watch src/server.ts",
    "verify": "node verify.mjs",
    "verify:stage3": "tsx verify-stage3.mjs",
    "verify:stage5": "tsx verify-stage5.mjs",
    "verify:auth": "node verify-auth.mjs",
    "verify:logging": "node verify-logging.mjs",
    "verify:validation": "node verify-validation.mjs",
    "verify:migrations": "tsx verify-migrations.mjs",
    "verify:config": "node verify-config.mjs",
    "verify:all": "node run-all.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "umzug": "^3.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
