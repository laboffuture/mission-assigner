{
  "name": "mission-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mission Hub — adaptive student-mission platform (Moodle SSO for students, staff login for SME/QC/admin)",
  "scripts": {
    "db:migrate": "tsx src/migrator.ts up",
    "db:migrate:down": "tsx src/migrator.ts down",
    "db:migrate:status": "tsx src/migrator.ts status",
    "db:seed": "tsx src/seed.ts",
    "set-password": "tsx src/setPassword.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "backup:verify": "bash scripts/backup-verify.sh",
    "publish": "tsx src/publish.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify": "node verify.mjs",
    "verify:stage3": "tsx verify-stage3.mjs",
    "verify:stage5": "tsx verify-stage5.mjs",
    "verify:auth": "node verify-auth.mjs",
    "verify:staff-auth": "node verify-staff-auth.mjs",
    "verify:login-ratelimit": "node verify-login-ratelimit.mjs",
    "verify:cookie-flags": "tsx verify-cookie-flags.mjs",
    "verify:logging": "node verify-logging.mjs",
    "verify:validation": "node verify-validation.mjs",
    "verify:migrations": "tsx verify-migrations.mjs",
    "verify:config": "node verify-config.mjs",
    "verify:prod-guard": "tsx verify-prod-guard.mjs",
    "verify:timezone": "tsx verify-timezone.mjs",
    "verify:concurrency": "tsx verify-concurrency.mjs",
    "verify:pagination": "node verify-pagination.mjs",
    "verify:all": "node run-all.mjs"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "umzug": "^3.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0"
  }
}
